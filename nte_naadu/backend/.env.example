# NTE Naadu only. Never copy HappiNotes production values here.
NODE_ENV=development
NTE_PORT=3100
NTE_MONGODB_URI=mongodb://127.0.0.1:27017/nte_naadu
NTE_MONGODB_DATABASE=nte_naadu
NTE_JWT_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
NTE_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Providers deliberately remain disabled until an approved integration exists.
NTE_VERIFICATION_PROVIDER=disabled
NTE_RECOVERY_PROVIDER=disabled
NTE_MEDIA_PROVIDER=disabled
NTE_ADULT_VERIFICATION_PROVIDER=disabled
NTE_PAYMENT_PROVIDER=disabled

# A policy is loaded from an approved NTE ConsentPolicy record. Do not use
# environment variables or seed data to invent consent wording.
