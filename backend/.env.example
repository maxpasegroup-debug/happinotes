# Server
NODE_ENV=development
PORT=3000

# Browser origins only: comma-separated scheme + host + optional port, no path.
# Localhost origins are allowed automatically outside production. Production
# must set CORS_ORIGINS to the confirmed browser clients, including
# https://happinotes.online; unlisted origins are rejected.
CORS_ORIGINS=

# MongoDB
MONGODB_URI=mongodb://localhost:27017/happinotes

# JWT
# Production: use at least 32 random bytes (256 bits), with at least 12 distinct
# bytes. Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Never commit a generated secret. This placeholder is intentionally invalid.
JWT_SECRET=replace-this-with-a-random-secret-before-use
JWT_EXPIRES_IN=7d

# The only installed limiter store is process-local memory. Limits are not
# shared across Railway replicas. Unsupported shared-store modes fail startup.
RATE_LIMIT_STORE=memory

# Admin bootstrap (server-only). Set ADMIN_BOOTSTRAP_PASSWORD only for the
# first startup when ADMIN_EMAIL does not exist, then remove it immediately.
# Never use a shared/default password. Existing admin passwords are not changed.
ADMIN_EMAIL=admin@happinotes.in
ADMIN_BOOTSTRAP_PASSWORD=

# Phone OTP delivery is not implemented in this repository. Use `test` only
# for local/test environments. Production must use `disabled`; phone OTP
# routes fail closed until an approved provider is implemented.
WHATSAPP_OTP_MODE=test

# Account deletion worker runs in the backend process by default. Set false
# only for an intentionally worker-disabled non-production process.
ACCOUNT_DELETION_WORKER_ENABLED=true

# Resend email OTP delivery (server only)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=no-reply@happinotes.online

# Firebase Admin SDK service account JSON (server only; never put this in Flutter)
FIREBASE_SERVICE_ACCOUNT_JSON=your-firebase-service-account-json

# Enable only for local/test purchase simulation; keep false in production.
PAYMENTS_TEST_MODE=false

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Store product provisioning: backend-only secrets; no credentials belong in Flutter.
# Initial prices: exact INR, India only. Existing store prices are never changed.
GOOGLE_PLAY_PACKAGE_NAME=com.happinotes.happinotes_flutter
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Pin a supported Android Publisher RegionsVersion from the official API documentation.
GOOGLE_PLAY_REGIONS_VERSION=
# Optional stable IDs; defaults are happinotes_premium_monthly/yearly.
GOOGLE_PLAY_SUBSCRIPTION_MONTHLY_PRODUCT_ID=happinotes_premium_monthly
GOOGLE_PLAY_SUBSCRIPTION_YEARLY_PRODUCT_ID=happinotes_premium_yearly
# App Store subscription identifiers are store-specific and intentionally unset
# until the owner confirms the exact App Store Connect product IDs.
APPLE_IAP_SUBSCRIPTION_MONTHLY_PRODUCT_ID=
APPLE_IAP_SUBSCRIPTION_YEARLY_PRODUCT_ID=
APP_STORE_CONNECT_APP_ID=
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_PRIVATE_KEY=

# Optional legacy migration source. Keep it until database migration is confirmed.
IAP_PRODUCTS_JSON={}

# Existing purchase verification configuration (separate Apple IAP key).
APPLE_BUNDLE_ID=com.happinotes.happinotesFlutter
APPLE_APP_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_PRIVATE_KEY=
APPLE_IAP_ENVIRONMENT=Sandbox
APPLE_ROOT_CERTIFICATES_JSON=[]
IAP_GOOGLE_NOTIFICATION_AUDIENCE=
IAP_GOOGLE_NOTIFICATION_EMAIL=
