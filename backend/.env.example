# Server
NODE_ENV=development
PORT=3000
CORS_ORIGINS=
MONGODB_URI=mongodb://localhost:27017/happinotes
JWT_SECRET=replace-this-with-a-random-secret-before-use
JWT_EXPIRES_IN=7d
RATE_LIMIT_STORE=memory
ADMIN_EMAIL=admin@happinotes.in
ADMIN_BOOTSTRAP_PASSWORD=
WHATSAPP_OTP_MODE=test
ACCOUNT_DELETION_WORKER_ENABLED=true
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=no-reply@happinotes.online
FIREBASE_SERVICE_ACCOUNT_JSON=your-firebase-service-account-json
PAYMENTS_TEST_MODE=false
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
GOOGLE_PLAY_PACKAGE_NAME=com.happinotes.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_REGIONS_VERSION=
GOOGLE_PLAY_SUBSCRIPTION_MONTHLY_PRODUCT_ID=happinotes_premium_monthly
GOOGLE_PLAY_SUBSCRIPTION_YEARLY_PRODUCT_ID=happinotes_premium_yearly
APPLE_IAP_SUBSCRIPTION_MONTHLY_PRODUCT_ID=
APPLE_IAP_SUBSCRIPTION_YEARLY_PRODUCT_ID=
APP_STORE_CONNECT_APP_ID=
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_PRIVATE_KEY=
IAP_PRODUCTS_JSON={}
APPLE_BUNDLE_ID=com.happinotes.app
APPLE_APP_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_PRIVATE_KEY=
APPLE_IAP_ENVIRONMENT=Sandbox
APPLE_ROOT_CERTIFICATES_JSON=[]
IAP_GOOGLE_NOTIFICATION_AUDIENCE=
IAP_GOOGLE_NOTIFICATION_EMAIL=
STORE_NOTIFICATION_OPS_KEY=

# System Status: server-side Railway project token (never NEXT_PUBLIC).
RAILWAY_TOKEN=
SYSTEM_STATUS_RAILWAY_PROJECT_ID=1dd27917-6b55-47ec-b116-d03c43d201f2
SYSTEM_STATUS_RAILWAY_ENVIRONMENT_ID=f0ec9237-de58-41b1-81f2-4dcadcb8940d
SYSTEM_STATUS_RAILWAY_SERVICE_ID=bedf0ec2-e8a7-464d-bf9e-fcacfada0769

# Public Web OAuth client ID from the Firebase / Google Cloud project.
GOOGLE_SIGN_IN_WEB_CLIENT_ID=

# Firebase Authentication browser handoff for Android Expo Go.
# Public Web app config from Firebase Project settings > General > Web app.
FIREBASE_WEB_CONFIG_JSON=
# Public website origin; deploy its browser proxy and authorize this domain in Firebase first.
# Automatically added to the exact CORS allowlist by current builds.
# Older deployed builds also need this origin explicitly in CORS_ORIGINS.
GOOGLE_SIGN_IN_BROWSER_ORIGIN=https://happinotes.online
