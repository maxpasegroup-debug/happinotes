# Server
NODE_ENV=development
PORT=3000

# MongoDB
MONGODB_URI=${{MongoDB.MONGO_URL}}
USE_EMBEDDED_MONGODB=false

# JWT
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_EXPIRES_IN=7d

# Password reset email (Resend)
RESEND_API_KEY=re_your_server_side_api_key
RESEND_FROM=HappiNotes <no-reply@your-verified-domain.com>

# Store purchase verification (backend secrets/settings only)
# Comma-separated base64 DER Apple Root CA certificates, e.g. Apple Root CA G3
APPLE_ROOT_CERTIFICATES_BASE64=
# Numeric App Store Connect Apple ID (required for production verification)
APPLE_APP_ID=
# Google Play service-account JSON with Android Publisher API access
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Google Pub/Sub authenticated push for subscription notifications
GOOGLE_PUBSUB_AUDIENCE=https://YOUR_API_DOMAIN/api/store-notifications/google
GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=

# Security
CORS_ORIGINS=
SENTRY_DSN=
EXPO_ACCESS_TOKEN=
MEDIA_STORAGE_PATH=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
