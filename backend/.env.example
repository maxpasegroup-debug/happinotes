# Server
NODE_ENV=development
PORT=3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/happinotes

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Admin (email that gets admin role on signup)
ADMIN_EMAIL=arundasmd@gmail.com

# Email / OTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HappiNotes <no-reply@happinotes.app>

# Security
CORS_ORIGINS=http://localhost:8081,http://localhost:3001
SENTRY_DSN=
EXPO_ACCESS_TOKEN=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MONTHLY_PLAN_ID=plan_xxxxx
RAZORPAY_YEARLY_PLAN_ID=plan_xxxxx
