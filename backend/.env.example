# Server
NODE_ENV=production
PORT=3000

# MongoDB
MONGODB_URI=${{MongoDB.MONGO_URL}}
USE_EMBEDDED_MONGODB=false

# JWT
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_EXPIRES_IN=7d

# Admin (email that gets admin role on signup)
ADMIN_EMAIL=arjunmd@email.com
ADMIN_PHONE_NUMBER=+918089239823

# Email / OTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HappiNotes <no-reply@happinotes.app>

# Security
CORS_ORIGINS=
SENTRY_DSN=
EXPO_ACCESS_TOKEN=
WHATSAPP_OTP_MODE=test
MEDIA_STORAGE_PATH=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MONTHLY_PLAN_ID=plan_xxxxx
RAZORPAY_YEARLY_PLAN_ID=plan_xxxxx
